#!/usr/bin/env sh
# Composer bin wrapper. ecs-go is a Go program; this builds the binary on first
# run (Go required) and execs it. Works as vendor/bin/ecs-go after installation.
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BINARY="$ROOT/ecs-go"

if [ ! -x "$BINARY" ]; then
    if ! command -v go >/dev/null 2>&1; then
        echo "ecs-go: Go toolchain required to build the binary (https://go.dev/dl)" >&2
        exit 1
    fi
    (cd "$ROOT" && go build -o "$BINARY" .)
fi

exec "$BINARY" "$@"
